      "color": "#8fc3e3"
    },
    "right": {
      "name": "박슈",
      "avatar": "img/SW.png",
      "color": "#b3a0e8"
    }
  },
  "messages": [
    { "side": "left",  "type": "text", "time": "18:00", "text": "6시땡ㅎㅎ", "date": "2026-07-20" },
    { "side": "right", "type": "text", "time": "18:00", "text": "똑똑" },
    { "side": "left",  "type": "text", "time": "18:01", "text": "박슈 아직 촬영중?ㅋㅋㅋ" },
    { "side": "right", "type": "text", "time": "18:01", "text": "저 여기 들어오려고" },
    { "side": "right", "type": "text", "time": "18:01", "text": "알람까지 맞춰놨어요" },
    { "side": "left",  "type": "text", "time": "18:01", "text": "나돈뎈ㅋㅋㅋㅋㅋ" },
    { "side": "right", "type": "text", "time": "18:01", "text": "ㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋ 역시😽" },
    { "side": "left",  "type": "text", "time": "18:01", "text": "기념으로 우리 같이찍은사진 하나 여기에 보내줘 슈야" },
    { "side": "right", "type": "text", "time": "18:02", "text": "오케이~~" },
    { "side": "right", "type": "text", "time": "18:02", "text": "갤러리에서 찾아보겠다." },
    { "side": "right", "type": "text", "time": "18:02", "text": "기다려 달라." },
    { "side": "left",  "type": "text", "time": "18:04", "text": "ㅋㅋㅋㅋㅋㅋ저 말투는 뭐야" },
    { "side": "left",  "type": "text", "time": "18:04", "text": "기다리겠다." },
    { "side": "right", "type": "text", "time": "18:05", "text": "내 유행어다." },
    { "side": "right", "type": "image", "time": "18:07", "src":"img/01.png" },
    { "side": "left",  "type": "text", "time": "18:07", "text": "아잌ㅋㅋㅋㅋ 자기만 잘나오고" },
    { "side": "left",  "type": "text", "time": "18:08", "text": "내표정 왜저러냐." },
    { "side": "right", "type": "text", "time": "18:08", "text": "귀여운데 왜에" },
    { "side": "right", "type": "text", "time": "18:09", "text": "안 그래요 여러분?" },
    { "side": "left",  "type": "text", "time": "18:09", "text": "ㅋㅋㅋㅋㅋ멋진거 많은뎈ㅋㅋㅋㅋ" },
    { "side": "left",  "type": "text", "time": "18:10", "text": "귀엽다니 넘어가드림😽" },
    { "side": "left",  "type": "text", "time": "18:11", "text": "아 그리고 송계장님도 프롬 오셨대ㅎㅎ 많이많이 놀러가줘~~" },
    { "side": "right", "type": "text", "time": "18:13", "text": "송계장님 웰컴 😽" },
    { "side": "right", "type": "text", "time": "18:13", "text": "근데 주검사님 지금 뭐하고 계세요?" },
    { "side": "right", "type": "text", "time": "18:13", "text": "비가 엄청 많이 오는데" },
    { "side": "right", "type": "text", "time": "18:14", "text": "좋아하는 러닝도 못 하겠다요" },
    { "side": "right", "type": "text", "time": "18:14", "text": "똑똑" },
    { "side": "right", "type": "text", "time": "18:14", "text": "낰낰" },
    { "side": "right", "type": "text", "time": "18:14", "text": "똑똑" },
    { "side": "right", "type": "text", "time": "18:15", "text": "나의 소중한 쉬는시간을\n당신에게 쓰겠다." },
    { "side": "right", "type": "text", "time": "18:15", "text": "5분 남았다." },
    { "side": "right", "type": "text", "time": "18:17", "text": "(언제 오나 지켜보겠다)" },
    { "side": "right", "type": "text", "time": "18:18", "text": "@주검사님" },
    { "side": "right", "type": "text", "time": "18:19", "text": "이 기능 만들어주시면 안될까요\n프롬 담당자님들?" },
    { "side": "right", "type": "icon", "time": "18:19", "src":"icon/011.png" },
    { "side": "left", "type": "text", "time": "18:20", "text": "아니" },
    { "side": "left", "type": "text", "time": "18:20", "text": "이거 알람이 따로 안오네ㅎㅎㅎ" },
    { "side": "right", "type": "text", "time": "18:20", "text": "이채하 삼행시 다시" },
    { "side": "right", "type": "text", "time": "18:20", "text": "이" },
    { "side": "left", "type": "text", "time": "18:21", "text": "이제야" },
    { "side": "right", "type": "text", "time": "18:21", "text": "채" },
    { "side": "left", "type": "text", "time": "18:21", "text": "채하랑" },
    { "side": "right", "type": "text", "time": "18:21", "text": "하" },
    { "side": "left", "type": "text", "time": "18:21", "text": "하나의 채팅방에서 이야기할수있게\n되어서 좋다" },
    { "side": "left", "type": "text", "time": "18:22", "text": "좀 잘했다" },
    { "side": "left", "type": "text", "time": "18:22", "text": "인정~?" },
    { "side": "right", "type": "text", "time": "18:22", "text": "하" },
    { "side": "right", "type": "text", "time": "18:22", "text": "하" },
    { "side": "left", "type": "text", "time": "18:22", "text": "다시 처음부터 해봐" },
    { "side": "right", "type": "text", "time": "18:23", "text": "오케이~" },
    { "side": "right", "type": "text", "time": "18:23", "text": "이" },
    { "side": "left", "type": "text", "time": "18:23", "text": "이제 솔직하게 말할게요" },
    { "side": "right", "type": "text", "time": "18:23", "text": "채" },
    { "side": "left", "type": "text", "time": "18:23", "text": "채하 주임이" },
    { "side": "right", "type": "text", "time": "18:23", "text": "하" },
    { "side": "left", "type": "text", "time": "18:24", "text": "하늘 계장님보다 좋다(송계장님 죄송해요😂)" },
    { "side": "left", "type": "icon", "time": "18:24", "src":"icon/068.png" },
    { "side": "left", "type": "text", "time": "18:24", "text": "이건 합격" },
    { "side": "right", "type": "text", "time": "18:24", "text": "아니 주검사님" },
    { "side": "right", "type": "text", "time": "18:24", "text": "당연한 거" },
    { "side": "right", "type": "text", "time": "18:24", "text": "지금 뭐하시는거지?" },
    { "side": "left", "type": "icon", "time": "18:24", "src":"icon/062.png" },
    { "side": "right", "type": "text", "time": "18:25", "text": "제가 보여드릴게요" },
    { "side": "right", "type": "text", "time": "18:25", "text": "ㄱ" },
    { "side": "left", "type": "text", "time": "18:25", "text": "이" },
    { "side": "right", "type": "text", "time": "18:25", "text": "아니 주검사님" },
    { "side": "right", "type": "text", "time": "18:25", "text": "주태선으로요" },
    { "side": "left", "type": "text", "time": "18:25", "text": "ㅋㅋㅋㅋㅋ" },
    { "side": "left", "type": "text", "time": "18:25", "text": "주" },
    { "side": "right", "type": "text", "time": "18:25", "text": "주저 없이 말할 수 있어요" },
    { "side": "left", "type": "text", "time": "18:25", "text": "태" },
    { "side": "right", "type": "text", "time": "18:26", "text": "태어나서 처음으로" },
    { "side": "left", "type": "text", "time": "18:26", "text": "선" },
    { "side": "right", "type": "text", "time": "18:26", "text": "선택한 남자가 너라고 🫵🏻" },
    { "side": "right", "type": "text", "time": "18:26", "text": "어떤데 ㅋ" },
    { "side": "right", "type": "text", "time": "18:26", "text": "ㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋ" },
    { "side": "right", "type": "text", "time": "18:26", "text": "잠시 손발이 없어져서 나갔다 올게여.." },
    { "side": "right", "type": "text", "time": "18:27", "text": "어딜나가!" },
    { "side": "right", "type": "text", "time": "18:27", "text": "나갔네" },
    { "side": "left", "type": "text", "time": "18:28", "text": "ㅋㅋㅋㅋ저녁먹을꺼야" },
    { "side": "left", "type": "text", "time": "18:28", "text": "박슈도 얼릉 저녁 챙겨머걱" },
    { "side": "right", "type": "text", "time": "18:29", "text": "뭐 드실 겁니까" },
    { "side": "right", "type": "text", "time": "18:29", "text": "저메추~~" },
    { "side": "left", "type": "text", "time": "18:30", "text": "지금 촬영장이면 먹고싶은것도 못먹겠네" },
    { "side": "right", "type": "text", "time": "18:31", "text": "샐러드 있어요 .." },
    { "side": "left", "type": "text", "time": "18:31", "text": "샐러드.. 안그래도 마른애한테 샐러드라니" },
    { "side": "right", "type": "text", "time": "18:33", "text": "난 이만 촬영하러 들어간다." },
    { "side": "right", "type": "text", "time": "18:33", "text": "밥 맛있게 먹고" },
    { "side": "right", "type": "text", "time": "18:33", "text": "삼행시 다시 준비하도록" },
    { "side": "left", "type": "text", "time": "18:33", "text": "잘하고 오슈" },
    { "side": "left", "type": "text", "time": "18:33", "text": "싫어~ 잘했잖아" },
    { "side": "right", "type": "voice", "time": "18:34", "src": "audio/260720_01.m4a" },
    { "side": "left", "type": "voice", "time": "18:34", "src": "audio/260720_02.m4a" },
    { "side": "left", "type": "text", "time": "18:50", "text": "나는 구운치킨 먹기로 결정했어ㅎㅎ🍗" },
    { "side": "left", "type": "text", "time": "18:53", "text": "우리 팬들도 저녁 잘 챙겨먹어~~😋" },
    { "side": "left", "type": "image", "time": "19:09", "src":"img/02.png" },
    { "side": "left", "type": "text", "time": "19:09", "text": "이주임 없을때 내사진 하나" },
    { "side": "left", "type": "text", "time": "19:14", "text": "비하인드로 촬영할때 내가 입었던\n옷이 내복,셔츠,베스트,자켓,코트였거든?" },
    { "side": "left", "type": "text", "time": "19:14", "text": "안그래도 몸이큰데 무슨 곰처럼 나오더라ㅋㅋㅋㅋㅋ" },
    { "side": "left", "type": "text", "time": "19:14", "text": "촬영하다보면 옷이 너무 무거워서\n목이랑 어깨가 진짜 많이 아팠어ㅠ" },
    { "side": "left", "type": "text", "time": "19:17", "text": "오히려 체격이 더 커보여서 좋았나?ㅋㅋㅋ" },
    { "side": "left", "type": "text", "time": "19:46", "text": "좋았다는 반응이 많아서 다행이다\nㅎㅎ" },
    { "side": "left", "type": "text", "time": "19:46", "text": "이주임도 열촬중이니" },
    { "side": "left", "type": "text", "time": "19:47", "text": "나도 내일 촬영할거 열심히 준비하러 가야겠다ㅎㅎ" },
    { "side": "left", "type": "text", "time": "19:47", "text": "다녀올게~~" },
    { "side": "right", "type": "text", "time": "21:23", "text": "이제끝났다" },
    { "side": "left", "type": "text", "time": "21:50", "text": "아이고 늦게까지도했네" },
    { "side": "left", "type": "text", "time": "21:50", "text": "고생했슈👍 얼릉 퇴근하고 맛있는거 먹어" },
    { "side": "right", "type": "text", "time": "22:23", "text": "나는 삼식이의 모습이 궁금하다." },
    { "side": "right", "type": "text", "time": "22:23", "text": "사진을 달라." },
    { "side": "right", "type": "text", "time": "22:23", "text": "그리고 당신은 무엇을 하고있나요?" },
    { "side": "left", "type": "text", "time": "22:28", "text": "ㅋㅋㅋㅋㅋ저 ai같은 말투뭐야" },
    { "side": "left", "type": "image", "time": "22:28", "src":"img/03.png" },
    { "side": "left", "type": "text", "time": "22:28", "text": "어때 너무 귀엽지ㅋㅋㅋㅋ" },
    { "side": "right", "type": "text", "time": "22:30", "text": "삼식이는 지금 나에게 메롱을 하나요?" },
    { "side": "right", "type": "text", "time": "22:32", "text": "형은 뭐하고있어요?" },
    { "side": "left", "type": "text", "time": "23:44", "text": "ㅋㅋㅋㅋㅋ나 내일 촬영하는데 준비할게 있어서" },
    { "side": "left", "type": "text", "time": "23:44", "text": "방금 끝!" },
    { "side": "left", "type": "text", "time": "23:47", "text": "박슈는 오늘 고생해서 잠들었나?ㅋㅋㅋ" },
    { "side": "right", "type": "text", "time": "23:58", "text": "전 형보다 체력이 좋아서 아직 쌩쌩" },

    { "side": "left", "type": "text", "time": "00:03", "text": "와.. 두세시간 자고 지금까지 쌩쌩한거면 진짜 대박이긴하다", "date": "2026-07-21" },
    { "side": "left", "type": "text", "time": "00:03", "text": "난 벌써 잘준비중인데ㅋㅋㅋㅋ" },
    { "side": "left", "type": "text", "time": "00:04", "text": "이주임 체력 인정!" },
    { "side": "left", "type": "text", "time": "00:13", "text": "이주임 내가 과제를 하나 줄게" },
    { "side": "left", "type": "text", "time": "00:13", "text": "체력이 약한 검사님은 이제 잘테니" },
    { "side": "left", "type": "text", "time": "00:13", "text": "이주임처럼 체력 강한" },
    { "side": "left", "type": "text", "time": "00:13", "text": "우리 팬들이랑 나대신 이야기 많이 해주고 자" },
    { "side": "left", "type": "text", "time": "00:13", "text": "이주임도 좋은꿈꿔🌙 굿나잇." },
    { "side": "left", "type": "voice", "time": "00:17", "src": "audio/260721_01.m4a" },
    { "side": "left", "type": "text", "time": "00:17", "text": "-주태선 말투-" },
    { "side": "right", "type": "voice", "time": "00:23", "src": "audio/260721_02.m4a" },
    { "side": "right", "type": "text", "time": "01:39", "text": "검사님이 과제를 주셨어요" },
    { "side": "right", "type": "text", "time": "01:39", "text": "체력이약한 자기대신 놀아주라구!!!" },
    { "side": "right", "type": "text", "time": "01:40", "text": "주검사님 자고있을때 내사진 하나" },
    { "side": "right", "type": "image", "time": "01:40", "src":"img/04.png" }
  ]
}
